#include <windows.h>

#define APC_VERSION      0,1,0,0
#define APC_VERSION_STR  "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APC_VERSION
PRODUCTVERSION  APC_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_SOUND
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Audio Program contributors"
            VALUE "FileDescription",  "Audio Program Virtual Cables Driver"
            VALUE "FileVersion",      APC_VERSION_STR
            VALUE "InternalName",     "AudioProgramCable.sys"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Audio Program contributors. Portions Copyright (C) Microsoft Corporation."
            VALUE "OriginalFilename", "AudioProgramCable.sys"
            VALUE "ProductName",      "Audio Program"
            VALUE "ProductVersion",   APC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
